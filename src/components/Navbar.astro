---
const navLinks = [
    { name: "Colecciones", href: "/colecciones" },
    { name: "Reconocimientos", href: "/reconocimientos" },
    { name: "Laboratorios", href: "/laboratorios" },
    { name: "Exposiciones", href: "/exposiciones" },
    { name: "Escrituras", href: "/escrituras" },
];
---

<nav
    id="navbar"
    class="fixed w-auto lg:inset-8 h-auto left-2 right-2 top-2 z-40"
    aria-label="Main navigation"
>
    <div class="flex justify-between w-full h-auto items-start">
        <!-- Brand – always visible -->
        <a
            id="nav-brand"
            class="text-xl font-black tracking-tighter text-slate-900 group shrink-0"
            href="#"
        >
            RIÓ<span
                class="text-[#05358f] group-hover:text-amber-500 transition-colors"
                >GRAFA</span
            >
        </a>

        <!-- Nav links + Escríbeme – fades on hero scroll -->
        <div id="nav-links-fade" class="flex flex-col items-end gap-1.5">
            <ul class="hidden lg:flex flex-col gap-1 items-end">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="nav-link text-slate-800 font-semibold text-right tracking-tight text-sm transition-colors duration-200"
                            >
                                {link.name}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a
                href="#"
                class="nav-link hidden lg:block text-[#f97316] text-sm font-semibold tracking-tight transition-colors duration-200 mt-0.5"
            >
                Escríbeme
            </a>
            <!-- Mobile hamburger: no ring, changes to orange when open -->
            <button
                id="nav-toggle"
                class="flex flex-col lg:hidden p-2 rounded-xl hover:bg-slate-100 transition-colors"
                aria-controls="nav-list"
                aria-expanded="false"
                aria-label="Abrir menú"
            >
                <svg
                    id="nav-icon-svg"
                    class="w-6 h-6 text-slate-900 transition-colors duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        id="nav-icon-path"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile menu: no hover bg -->
    <div
        id="nav-list"
        class="lg:hidden hidden absolute top-16 w-full h-auto backdrop-blur-xl overflow-hidden pb-4"
    >
        <ul class="flex flex-col gap-1 h-auto pb-4 pt-2">
            {
                navLinks.map((link) => (
                    <li class="nav-item opacity-0 transform translate-x-4">
                        <a
                            href={link.href}
                            class="mobile-nav-link block text-2xl font-bold text-slate-900 px-4 py-5 h-auto rounded-xl transition-colors duration-200"
                        >
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<style>
    .nav-link:hover {
        color: #f97316;
    }
    .mobile-nav-link:hover {
        color: #f97316;
    }
    /* When menu is open, hamburger icon turns orange */
    #nav-toggle[aria-expanded="true"] #nav-icon-svg {
        stroke: #f97316;
        color: #f97316;
    }
</style>

<script>
    import { gsap } from "https://esm.sh/gsap";

    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-list");
    const iconSvg = document.getElementById("nav-icon-svg");
    const items = document.querySelectorAll(".nav-item");
    let isOpen = false;

    if (toggle && menu) {
        toggle.addEventListener("click", () => {
            isOpen = !isOpen;
            toggle.setAttribute("aria-expanded", isOpen.toString());

            // Icon color: slate when closed, orange when open
            if (iconSvg) {
                gsap.to(iconSvg, {
                    color: isOpen ? "#f97316" : "#0f172a",
                    duration: 0.25,
                    ease: "power2.out",
                });
            }

            if (isOpen) {
                menu.classList.remove("hidden");
                gsap.fromTo(
                    menu,
                    { height: 0, opacity: 0 },
                    {
                        height: "auto",
                        opacity: 1,
                        duration: 0.45,
                        ease: "expo.out",
                    },
                );
                gsap.to(items, {
                    x: 0,
                    opacity: 1,
                    duration: 0.35,
                    stagger: 0.07,
                    ease: "back.out(1.7)",
                    delay: 0.1,
                });
            } else {
                gsap.to(items, {
                    x: 20,
                    opacity: 0,
                    duration: 0.2,
                    stagger: 0.04,
                    ease: "power2.in",
                });
                gsap.to(menu, {
                    height: 0,
                    opacity: 0,
                    duration: 0.35,
                    ease: "expo.inOut",
                    onComplete: () => menu.classList.add("hidden"),
                });
            }
        });
    }

    // Scroll direction: hide nav-links-fade on scroll DOWN in hero
    let lastScrollY = window.scrollY;
    let scrollTicking = false;
    let navLinksHiddenByScroll = false;

    window.addEventListener("scroll", () => {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(() => {
            const currentY = window.scrollY;
            const delta = currentY - lastScrollY;
            const navLinks = document.getElementById("nav-links-fade");
            const heroSection = document.getElementById("hero-section");
            const inHero =
                heroSection &&
                currentY < heroSection.offsetTop + heroSection.offsetHeight;

            if (navLinks && !inHero) {
                if (delta > 6 && currentY > 80 && !navLinksHiddenByScroll) {
                    navLinksHiddenByScroll = true;
                    gsap.to(navLinks, {
                        y: -40,
                        opacity: 0,
                        duration: 0.35,
                        ease: "power2.inOut",
                        overwrite: "auto",
                    });
                } else if (delta < -4 && navLinksHiddenByScroll) {
                    navLinksHiddenByScroll = false;
                    gsap.to(navLinks, {
                        y: 0,
                        opacity: 1,
                        duration: 0.35,
                        ease: "power2.out",
                        overwrite: "auto",
                    });
                }
            }
            lastScrollY = currentY;
            scrollTicking = false;
        });
    });
</script>
