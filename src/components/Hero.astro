---
// Hero.astro
---

<section
  class="relative w-screen h-100dvh flex flex-col justify-end items-center lg:items-end overflow-hidden bg-gradient-to-r from-[#aeaeb8] via-[#e9dac3] to-[#e5d9dd]"
>
  <div id="model-3d-container" class="absolute inset-0 w-full h-full z-0"></div>

  <div
    class=" absolute w-auto  h-auto left-2 right-2 bottom-2 lg:bottom-8 lg:right-8 z-10 flex flex-col items-center lg:items-end gap-2 p-6 lg:px-20 text-center lg:text-right rounded-2xl"
  >
    <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight">
      Luisa Fernanda Giraldo Murillo
    </h1>
    <p class="text-md text-slate-700 font-medium w-full lg:w-lg">
      Magíster Interdisciplinar en Teatro y Artes Vivas y 
      estudiante de Doctorado en Arte y Arquitectura - UNAL
    </p>
  </div>
</section>

<script>
  // Use CDN imports to bypass local bundling issues with bare specifiers and base paths
  import * as THREE from "https://esm.sh/three@0.183.0";
  import { GLTFLoader } from "https://esm.sh/three@0.183.0/examples/jsm/loaders/GLTFLoader.js";
  import { OrbitControls } from "https://esm.sh/three@0.183.0/examples/jsm/controls/OrbitControls.js";

  async function initInline(container, modelUrl) {
    const scene = new THREE.Scene();
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(
      container.clientWidth || window.innerWidth,
      container.clientHeight || window.innerHeight,
    );
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    const camera = new THREE.PerspectiveCamera(
      45,
      (container.clientWidth || window.innerWidth) /
        (container.clientHeight || window.innerHeight),
      0.1,
      1000,
    );
    camera.position.set(0, 1, 5);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    scene.add(new THREE.AmbientLight(0xffffff, 1.0));
    const dir = new THREE.DirectionalLight(0xffffff, 1.2);
    dir.position.set(5, 10, 7.5);
    scene.add(dir);

    // [3D Fix] Load model and optimize for full-screen
    const loader = new GLTFLoader();
    const gltf = await loader.loadAsync(modelUrl);
    const model = gltf.scene;
    scene.add(model);

    // [3D Fix] Centrado y Ajuste de Cámara para visibilidad TOTAL
    const box = new THREE.Box3().setFromObject(model);
    const sphere = box.getBoundingSphere(new THREE.Sphere());
    const center = sphere.center;
    const size = box.getSize(new THREE.Vector3());

    // Centrar el modelo
    model.position.x = -center.x;
    model.position.y = -center.y;
    model.position.z = -center.z;

    // Escala base
    const maxDim = Math.max(size.x, size.y, size.z);
    model.scale.setScalar(1.3); // Reset scale to 1 for sphere calculation

    // Calcular distancia de cámara para que quepa todo el modelo (Fit to Viewport)
    const fov = camera.fov * (Math.PI / 180);
    let distance = Math.abs(sphere.radius / Math.sin(fov / 2));

    // Ajuste para pantallas verticales (Portrait)
    const aspect =
      (container.clientWidth || window.innerWidth) /
      (container.clientHeight || window.innerHeight);
    if (aspect < 1) {
      distance = distance / aspect;
    }

    camera.position.set(0, 0, distance * 1.2); // 1.2 para un poco de margen (padding)
    camera.lookAt(0, 0, 0);

    controls.target.set(0, 0, 0);
    controls.update();

    console.log("[3D Fix] Bounding Radius:", sphere.radius);
    console.log("[3D Fix] Camera Distance:", distance);

    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      const delta = clock.getDelta();

      // Renderizar escena
      renderer.render(scene, camera);
    }
    animate();

    function handleScroll() {
      if (model) {
        const scrollY = window.scrollY;
        model.rotation.y = scrollY * 0.005;
      }
    }
    window.addEventListener("scroll", handleScroll);

    function handleResize() {
      const w = container.clientWidth || window.innerWidth;
      const h = container.clientHeight || window.innerHeight;
      const aspect = w / h;

      camera.aspect = aspect;
      camera.updateProjectionMatrix();

      // Recalcular distancia óptima en resize
      let newDistance = Math.abs(sphere.radius / Math.sin(fov / 2));
      if (aspect < 1) {
        newDistance = newDistance / aspect;
      }
      camera.position.z = newDistance * 1.2;

      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    }
    window.addEventListener("resize", handleResize);

    return {
      scene,
      camera,
      renderer,
      dispose() {
        window.removeEventListener("resize", handleResize);
        try {
          renderer.dispose();
        } catch (e) {}
        if (container.contains(renderer.domElement))
          container.removeChild(renderer.domElement);
      },
    };
  }

  (async () => {
    const container = document.getElementById("model-3d-container");
    if (!container) return;

    // Improved path resolution for GLB
    const baseUrl = document.querySelector("base")?.getAttribute("href") || "/";
    const cleanBase = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
    const modelPath = cleanBase + "models/mapa-colombia.glb";

    console.log("[3D Fix] Intentando cargar modelo en:", modelPath);

    try {
      const scene = await initInline(container, modelPath);
      window.threeScene = scene;
      console.log("[Hero] modelo cargado en:", modelPath);
    } catch (err) {
      console.error("[Hero] Error cargando GLB", err);
      const e = document.createElement("div");
      e.textContent = "3D error: " + (err.message || err);
      e.style.cssText =
        "position:fixed;left:8px;top:8px;background:#ffcdd2;color:#b71c1c;padding:8px;z-index:9999;";
      container.appendChild(e);
    }
  })();
</script>

<style>
  #model-3d-container {
    position: absolute; /* Changed from fixed to absolute within relative section */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
</style>
